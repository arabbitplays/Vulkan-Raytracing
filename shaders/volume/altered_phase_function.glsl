float evaluateAlteredPhaseFunction(vec3 wo, vec3 wi, float g) {
    float x = dot(wo, wi);
    int idx = int(min((x + 1.0) * float(NUM_COEFFS) * 0.5, float(NUM_COEFFS - 1)));
    idx = clamp(idx, 0, NUM_COEFFS - 1);

    float coeffs[NUM_COEFFS];
    getPhaseCoefficients(g, coeffs);
    return coeffs[idx];
}

