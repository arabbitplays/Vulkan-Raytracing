#version 460
#extension GL_EXT_ray_tracing : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

#include "../common/scene_data.glsl"
#include "../common/random.glsl"
#include "../common/camera.glsl"
#include "../common/path_sampler.glsl"

#include "options.glsl"

#include "../mlmc/path_length_mlmc.glsl"
#include "../mlmc/similarity_mlmc.glsl"

#define STORE_RNG true

layout(binding = 1, set = 0, rgba32f) uniform image2D image;
layout(binding = 13, set = 0, rgba32f) uniform image2D diff_image;
layout(binding = 14, set = 0, rgba32f) uniform image2D mlmc_image;

vec3 unbiasedEstimator(uint sample_count) {
    EvaluationOptions eval_options = getUserOptions();

    vec3 color = vec3(0);
    for (int i = 0; i < sample_count; i++) {
        ViewRay view_ray = generateViewRay(vec2(gl_LaunchIDEXT.xy), vec2(gl_LaunchSizeEXT.xy), sceneData.inv_view, sceneData.inv_proj, payload.rng_state);
        initPayload(view_ray.origin, view_ray.direction);
        takePathSample(options.recursion_depth);
        color += evaluatePath(eval_options, payload.rng_state);
    }
    color /= sample_count;
    return color;
}

vec3 biasedEstimator(uint sample_count, uint mlmc_method) {
    if (mlmc_method == 0) {
        return pathLengthMlmc(sample_count, options.biased_path_length);
    } else if (mlmc_method == 1 || mlmc_method == 2 || mlmc_method == 3 || mlmc_method == 4) {
        return similarityMlmc(sample_count, options.recursion_depth);
    }
    return vec3(1, 0, 0);
}

vec3 diffEstimator(uint sample_count, uint mlmc_method) {
    if (mlmc_method == 0) {
        return pathLengthDiffMlmc(sample_count, options.biased_path_length, options.recursion_depth);
    } else if (mlmc_method == 1) {
        return similarityDiffMlmc(sample_count, options.recursion_depth, RESAMPLE_CORRELATION_MODE);
    } else if (mlmc_method == 2) {
        return similarityDiffMlmc(sample_count, options.recursion_depth, SAME_PATH_CORRELATION_MODE);
    } else if (mlmc_method == 3) {
        return similarityDiffMlmc(sample_count, options.recursion_depth, SKIP_DETERMINISTIC_CORRELATION_MODE);
    } else if (mlmc_method == 4) {
        return similarityDiffMlmc(sample_count, options.recursion_depth, SKIP_RANDOM_CORRELATION_MODE);
    }
    return vec3(1, 0, 0);
}

void main() {
    payload.rng_state = imageLoad(rng_tex, ivec2(gl_LaunchIDEXT.xy));

    if (!options.do_mlmc) {
        uint accum_count = options.accumulated_frame_count;

        vec3 color = unbiasedEstimator(options.samples_per_pixel);
        if (accum_count != 0) {
            vec3 prev_color = imageLoad(image, ivec2(gl_LaunchIDEXT.xy)).xyz;
            color = (accum_count * prev_color + color) / (accum_count + 1);
        }
        imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(color, 1.0));
    } else {
        uint accum_count = options.accumulated_frame_count;
        uint diff_accum_count = options.accumulated_diff_frame_count;

        vec3 diff;
        if (options.diff_samples_per_pixel > 0) {
            diff = diffEstimator(options.diff_samples_per_pixel, options.mlmc_method);
            if (diff_accum_count != 0) {
                vec3 prev_diff = imageLoad(diff_image, ivec2(gl_LaunchIDEXT.xy)).xyz;
                diff = (diff_accum_count * prev_diff + diff) / (diff_accum_count + 1);
            }
            imageStore(diff_image, ivec2(gl_LaunchIDEXT.xy), vec4(diff, 1.0));
        } else {
            diff = diff_accum_count == 0 ? vec3(0) : imageLoad(diff_image, ivec2(gl_LaunchIDEXT.xy)).xyz;
        }

        vec3 color;
        if (options.samples_per_pixel > 0) {
            color = biasedEstimator(options.samples_per_pixel, options.mlmc_method);
            if (accum_count != 0) {
                vec3 prev_color = imageLoad(image, ivec2(gl_LaunchIDEXT.xy)).xyz;
                color = (accum_count * prev_color + color) / (accum_count + 1);
            }
            imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(color, 1.0));
        } else {
             color = imageLoad(image, ivec2(gl_LaunchIDEXT.xy)).xyz;
        }

        imageStore(mlmc_image, ivec2(gl_LaunchIDEXT.xy), vec4(color + diff, 1.0));
    }

    if (STORE_RNG) {
        imageStore(rng_tex, ivec2(gl_LaunchIDEXT.xy), payload.rng_state);
    }
}