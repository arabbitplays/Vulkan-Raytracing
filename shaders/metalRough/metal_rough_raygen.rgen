#version 460
#extension GL_EXT_ray_tracing : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

#include "../common/scene_data.glsl"
#include "../common/random.glsl"
#include "../common/camera.glsl"
#include "../common/path_sampler.glsl"
#include "../common/luminance.glsl"
#include "../common/debug.glsl"

#include "options.glsl"

#include "../mlmc/path_length_mlmc.glsl"
#include "../mlmc/similarity_mlmc.glsl"
#include "../mlmc/homo_mlmc.glsl"

#define STORE_RNG true

layout(binding = 1, set = 0, rgba32f) uniform image2D image;
layout(binding = 13, set = 0, rgba32f) uniform image2D diff_image;
layout(binding = 14, set = 0, rgba32f) uniform image2D mlmc_image;
layout(binding = 16, set = 0, rg32f) uniform image2D moment_image;
layout(binding = 17, set = 0, r32ui) uniform uimage2D diff_sample_count_image;

vec3 unbiasedEstimator(uint sample_count) {
    EvaluationOptions eval_options = getUserOptions();

    vec3 color = vec3(0);
    for (int i = 0; i < sample_count; i++) {
        ViewRay view_ray = generateViewRay(vec2(gl_LaunchIDEXT.xy), vec2(gl_LaunchSizeEXT.xy), sceneData.inv_view, sceneData.inv_proj, payload.rng_state);
        initPayload(view_ray.origin, view_ray.direction);
        takePathSample(options.recursion_depth);
        color += evaluatePath(eval_options, payload.rng_state);
    }
    color /= sample_count;
    return color;
}

// The dispatch is over SPEC_MLMC_METHOD, so the compiler folds these to a
// single tail call per pipeline variant and DCEs the other estimators.
vec3 biasedEstimator(uint sample_count) {
    if (SPEC_MLMC_METHOD == 0) {
        return pathLengthMlmc(sample_count, options.biased_path_length);
    } else if (SPEC_MLMC_METHOD == 1 || SPEC_MLMC_METHOD == 2 || SPEC_MLMC_METHOD == 3 || SPEC_MLMC_METHOD == 4) {
        return similarityMlmc(sample_count, options.recursion_depth);
    } else if (SPEC_MLMC_METHOD == 5) {
        return homoMlmc(sample_count, options.recursion_depth);
    }
    return vec3(1, 0, 0);
}

vec3 diffEstimator(uint sample_count) {
    if (SPEC_MLMC_METHOD == 0) {
        return pathLengthDiffMlmc(sample_count, options.biased_path_length, options.recursion_depth);
    } else if (SPEC_MLMC_METHOD == 1) {
        return similarityDiffMlmc(sample_count, options.recursion_depth, RESAMPLE_CORRELATION_MODE);
    } else if (SPEC_MLMC_METHOD == 2) {
        return similarityDiffMlmc(sample_count, options.recursion_depth, SAME_PATH_CORRELATION_MODE);
    } else if (SPEC_MLMC_METHOD == 3) {
        return similarityDiffMlmc(sample_count, options.recursion_depth, SKIP_DETERMINISTIC_CORRELATION_MODE);
    } else if (SPEC_MLMC_METHOD == 4) {
        return similarityDiffMlmc(sample_count, options.recursion_depth, SKIP_RANDOM_CORRELATION_MODE);
    } else if (SPEC_MLMC_METHOD == 5) {
        return homoDiffMlmc(sample_count, options.recursion_depth);
    }
    return vec3(1, 0, 0);
}

void main() {
    payload.rng_state = imageLoad(rng_tex, ivec2(gl_LaunchIDEXT.xy));

    if (!SPEC_DO_MLMC) {
        uint accum_count = options.accumulated_frame_count;

        vec3 color = unbiasedEstimator(options.samples_per_pixel);
        if (accum_count != 0) {
            vec3 prev_color = imageLoad(image, ivec2(gl_LaunchIDEXT.xy)).xyz;
            color = (accum_count * prev_color + color) / (accum_count + 1);
        }
        imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(color, 1.0));
    } else {
        uint accum_count = options.accumulated_frame_count;
        uint global_diff_accum_count = options.accumulated_diff_frame_count;

        // .x for color, .y for diff.
        vec2 prev_m2 = imageLoad(moment_image, ivec2(gl_LaunchIDEXT.xy)).xy;
        if (accum_count == 0) prev_m2.x = 0.0;

        uint pixel_diff_count = global_diff_accum_count == 0
            ? 0u
            : imageLoad(diff_sample_count_image, ivec2(gl_LaunchIDEXT.xy)).x;
        if (pixel_diff_count == 0) prev_m2.y = 0.0;
        vec2 new_m2 = prev_m2;

        vec3 prev_diff = pixel_diff_count == 0 ? vec3(0)
                                               : imageLoad(diff_image, ivec2(gl_LaunchIDEXT.xy)).xyz;

        // Uses main-color luminance as the absolute-error scale so pixels with
        // near-zero diff can still converge.
        float color_lum_prev = luminance(imageLoad(image, ivec2(gl_LaunchIDEXT.xy)).xyz);
        float abs_floor = options.adaptive_error_bound * max(color_lum_prev, 1e-4);
        bool converged = options.adaptive_sampling
            && stop_sampling(luminance(prev_diff), prev_m2.y, pixel_diff_count,
                             options.adaptive_min_samples,
                             options.adaptive_error_bound, abs_floor);

        vec3 diff;
        if (options.diff_samples_per_pixel > 0 && !converged) {
            vec3 diff_sample = diffEstimator(options.diff_samples_per_pixel);
            float sample_lum = luminance(diff_sample);
            float prev_mean_lum = luminance(prev_diff);

            if (pixel_diff_count != 0) {
                diff = (pixel_diff_count * prev_diff + diff_sample) / (pixel_diff_count + 1);
            } else {
                diff = diff_sample;
            }
            float new_mean_lum = luminance(diff);
            new_m2.y = prev_m2.y + (sample_lum - prev_mean_lum) * (sample_lum - new_mean_lum);
            pixel_diff_count += 1;
            imageStore(diff_image, ivec2(gl_LaunchIDEXT.xy), vec4(diff, 1.0));
        } else {
            diff = prev_diff;
        }
        imageStore(diff_sample_count_image, ivec2(gl_LaunchIDEXT.xy), uvec4(pixel_diff_count, 0, 0, 0));

        vec3 color;
        uint new_color_count = accum_count;
        if (options.samples_per_pixel > 0) {
            vec3 color_sample = biasedEstimator(options.samples_per_pixel);
            float sample_lum = luminance(color_sample);

            if (accum_count != 0) {
                vec3 prev_color = imageLoad(image, ivec2(gl_LaunchIDEXT.xy)).xyz;
                float prev_mean_lum = luminance(prev_color);
                color = (accum_count * prev_color + color_sample) / (accum_count + 1);
                float new_mean_lum = luminance(color);
                new_m2.x = prev_m2.x + (sample_lum - prev_mean_lum) * (sample_lum - new_mean_lum);
            } else {
                color = color_sample;
                new_m2.x = 0.0;
            }
            new_color_count = accum_count + 1;
            imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(color, 1.0));
        } else {
             color = imageLoad(image, ivec2(gl_LaunchIDEXT.xy)).xyz;
        }

        imageStore(moment_image, ivec2(gl_LaunchIDEXT.xy), vec4(new_m2, 0.0, 0.0));
        imageStore(mlmc_image, ivec2(gl_LaunchIDEXT.xy), vec4(color + diff, 1.0));

        if (options.debug_variance) {
            vec3 debug_color = getVarianceDebugColor(new_m2.x, new_color_count);
            imageStore(mlmc_image, ivec2(gl_LaunchIDEXT.xy), vec4(debug_color, 1.0));
        }
        if (options.debug_diff_variance) {
            vec3 debug_color = getVarianceDebugColor(new_m2.y, pixel_diff_count);
            imageStore(mlmc_image, ivec2(gl_LaunchIDEXT.xy), vec4(debug_color, 1.0));
        }
        if (options.debug_adaptive_sampling) {
            float abs_floor_dbg = options.adaptive_error_bound * max(luminance(color), 1e-4);
            vec3 debug_color = getAdaptiveSamplingDebugColor(diff, new_m2.y, pixel_diff_count,
                                                             options.adaptive_min_samples,
                                                             options.adaptive_error_bound,
                                                             abs_floor_dbg, color);
            imageStore(mlmc_image, ivec2(gl_LaunchIDEXT.xy), vec4(debug_color, 1.0));
        }
    }

    if (STORE_RNG) {
        imageStore(rng_tex, ivec2(gl_LaunchIDEXT.xy), payload.rng_state);
    }
}